<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
        logicalFilePath="changelog-6.7.0">

    <!-- CS-1: add organizationid to tc_groups for group→client resolution -->
    <changeSet author="author" id="changelog-6.7.0-add-organizationid-to-groups">

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tc_groups"/>
            <not>
                <columnExists tableName="tc_groups" columnName="organizationid"/>
            </not>
        </preConditions>

        <addColumn tableName="tc_groups">
            <column name="organizationid" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="tc_groups"
                baseColumnNames="organizationid"
                referencedTableName="tc_organization"
                referencedColumnNames="id"
                onDelete="SET NULL"
                constraintName="fk_tc_groups_organization"/>

        <createIndex tableName="tc_groups" indexName="idx_groups_organizationid">
            <column name="organizationid"/>
        </createIndex>

    </changeSet>

    <!-- CS-2: create tc_vin_mappings table -->
    <changeSet author="author" id="changelog-6.7.0-create-vin-mappings">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tc_vin_mappings"/>
            </not>
        </preConditions>

        <createTable tableName="tc_vin_mappings">
            <column autoIncrement="true" name="id" type="INT">
                <constraints primaryKey="true"/>
            </column>
            <column name="organizationid" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="imei" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="vin" type="VARCHAR(17)">
                <constraints nullable="false"/>
            </column>
            <column name="deviceid" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="appliedat" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <!-- attributes holds error/status JSON, e.g. {"error":"vin-conflict"} -->
            <column name="attributes" type="VARCHAR(4000)" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- one VIN per IMEI per client -->
        <addUniqueConstraint
                tableName="tc_vin_mappings"
                columnNames="organizationid, imei"
                constraintName="uq_vin_mappings_org_imei"/>

        <!-- FK: cascade delete when org is removed -->
        <addForeignKeyConstraint
                baseTableName="tc_vin_mappings"
                baseColumnNames="organizationid"
                referencedTableName="tc_organization"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_vin_mappings_organization"/>

        <!-- FK: set null when device is deleted -->
        <addForeignKeyConstraint
                baseTableName="tc_vin_mappings"
                baseColumnNames="deviceid"
                referencedTableName="tc_devices"
                referencedColumnNames="id"
                onDelete="SET NULL"
                constraintName="fk_vin_mappings_device"/>

        <!-- lookup index: hook walks (organizationid, imei) -->
        <createIndex tableName="tc_vin_mappings" indexName="idx_vin_mappings_imei">
            <column name="imei"/>
        </createIndex>

    </changeSet>

    <!-- CS-3: add groupid to tc_vin_mappings so a mapping can pin a device to a group -->
    <changeSet author="author" id="changelog-6.7.0-add-groupid-to-vin-mappings">

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tc_vin_mappings"/>
            <not>
                <columnExists tableName="tc_vin_mappings" columnName="groupid"/>
            </not>
        </preConditions>

        <addColumn tableName="tc_vin_mappings">
            <column name="groupid" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="tc_vin_mappings"
                baseColumnNames="groupid"
                referencedTableName="tc_groups"
                referencedColumnNames="id"
                onDelete="SET NULL"
                constraintName="fk_vin_mappings_group"/>

        <createIndex tableName="tc_vin_mappings" indexName="idx_vin_mappings_groupid">
            <column name="groupid"/>
        </createIndex>

    </changeSet>

    <!-- CS-4: add userid to tc_vin_mappings to track which user created the mapping -->
    <changeSet author="author" id="changelog-6.7.0-add-userid-to-vin-mappings">

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tc_vin_mappings"/>
            <not>
                <columnExists tableName="tc_vin_mappings" columnName="userid"/>
            </not>
        </preConditions>

        <addColumn tableName="tc_vin_mappings">
            <column name="userid" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="tc_vin_mappings"
                baseColumnNames="userid"
                referencedTableName="tc_users"
                referencedColumnNames="id"
                onDelete="SET NULL"
                constraintName="fk_vin_mappings_user"/>

        <createIndex tableName="tc_vin_mappings" indexName="idx_vin_mappings_userid">
            <column name="userid"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
